@page
@model IndexModel
@{
    ViewData["Title"] = "The Home for Pizza Lovers";
TimeSpan timeInBusiness = DateTime.Now - new DateTime(2018, 8, 14);
}

<div class="container">
    <div class="text-center mt-5">
        <h1 class="display-3 fw-bold text-primary">Welcome to Contoso Pizza</h1>
        <p class="lead text-muted mb-4">The best pizza in town for @Convert.ToInt32(timeInBusiness.TotalDays) days!</p>
    </div>

    <div class="row justify-content-center mt-4">
        <div class="col-md-8">
            <div class="card shadow">
                <div class="card-body p-4">
                    <h2 class="card-title h4 mb-3">Why Choose Us?</h2>
                    <ul class="list-unstyled">
                        <li class="mb-2"><span class="badge bg-success me-2">✓</span>Fresh ingredients daily</li>
                        <li class="mb-2"><span class="badge bg-success me-2">✓</span>Family recipes since 2018</li>
                        <li class="mb-2"><span class="badge bg-success me-2">✓</span>Fast delivery</li>
                    </ul>
                    <div class="d-flex gap-2 mt-4">
                        <a href="/PizzaList" class="btn btn-primary btn-lg">View Menu</a>
                        <a href="/Privacy" class="btn btn-outline-secondary btn-lg">Learn More</a>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div class="alert alert-info mt-4 text-center" role="alert">
        <strong>Special Offer!</strong> Order now and get 10% off your first pizza.
    </div>
</div>
