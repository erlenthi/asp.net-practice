@page
@model WebApplication1.Pages.PizzaListModel
@using WebApplication1.Models
@{
    ViewData["Title"] = "Pizza List 🍕";
}
<h1>Pizza List 🍕</h1>

<!-- New Pizza form will go here -->

<table class="table mt-5">
    <thead>
        <tr>
            <th scope="col">Name</th>
            <th scope="col">Price</th>
            <th scope="col">Size</th>
            <th scope="col">Gluten Free</th>
            <th scope="col">Delete</th>
        </tr>
    </thead>
    <tbody>

        @foreach (var pizza in Model.PizzaList)
        {
            <tr class="bg-dark">
                <td id="@("Id" + pizza.Id)">@pizza.Name</td>
                <td>@($"{pizza.Price:C}")</td>
                <td>@pizza.Size</td>
                <td>@(pizza.IsGlutenFree ? "✔️" : string.Empty)</td>
                <td>
                    <form method="post" asp-page-handler="Delete" asp-route-id="@pizza.Id">
                        <button class="btn btn-dark ">Delete</button>
                    </form>
                </td>
            </tr>
        }
    </tbody>

    <ul>
        @foreach (var topping in Enum.GetValues<Topping>())
        {
            <button class="@topping">
                <li>@topping</li>
            </button>
        }
    </ul>


    <!--A progress bar that continously fills and starts from 0 again-->
</table>

<script>
    const pizzaData = @Html.Raw(Json.Serialize(Model.PizzaList));
    const toppings = @Html.Raw(Json.Serialize(Enum.GetValues<Topping>().Select(t => t.ToString())));
    console.log(toppings);

