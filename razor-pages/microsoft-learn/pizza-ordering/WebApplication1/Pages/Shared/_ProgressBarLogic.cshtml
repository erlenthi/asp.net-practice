<div class="progress-wrapper">
    <div class="progress">
        <div class="progress-bar progress-bar-striped progress-bar-animated" style="width:40%"></div>
    </div>


    <!--A new card is added every time the progressbar is filled-->
    <container>
        <div class="pizzaCard d-flex flex-wrap">
            
            <div class="card">Pizza</div>
        </div>
    </container>
</div>

<script>
    (function() {
        // Get the script's parent wrapper (scope to THIS partial only)
        const currentScript = document.currentScript;
        const wrapper = currentScript.previousElementSibling;
        
        const bar = wrapper.querySelector(".progress-bar");
        const container = wrapper.querySelector(".pizzaCard");
        
        let i = 0;
        
        function increaseProgressBar() {
            i++;
            bar.style.width = (i % 100) + "%";
            
            if (i % 100 == 0) {
                const div = document.createElement("div");
                div.className = "card m-3 p-3";
                div.textContent = "Pizza #" + (i / 100);
                container.appendChild(div);
            }
        }
        
        setInterval(increaseProgressBar, 10);
    })();
</script>