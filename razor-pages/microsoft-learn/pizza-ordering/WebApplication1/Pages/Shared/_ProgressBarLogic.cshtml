<div class="progress-wrapper">
    <div class="progress">
        <div class="progress-bar progress-bar-striped progress-bar-animated" style="width:0%"></div>
    </div>


    <!--A new card is added every time the progressbar is filled-->
    <container>
        <div class="pizzaCard d-flex flex-wrap">

            <div class="card">Pizza</div>
        </div>
    </container>

    <button class = "pauseButton btn btn-danger">Pause</button>
</div>

<script>
    
    (function () {
        const pizzaData = @Html.Raw(Json.Serialize(Model.PizzaList));
        // Get the script's parent wrapper (scope to THIS partial only)
        const currentScript = document.currentScript;
        const wrapper = currentScript.previousElementSibling;

        const bar = wrapper.querySelector(".progress-bar");
        const container = wrapper.querySelector(".pizzaCard");
        const pauseButton = wrapper.querySelector(".pauseButton")

        let i = 0;
        let pause = false; 

        pauseButton.addEventListener("click",(e)=> {
            pause = !pause; 
        });

        function increaseProgressBar() {
            if(!pause) i++;
            bar.style.width = (i % 100) + "%";
            const div = document.createElement("div");
            div.className = "card m-3 p-3";
            div.textContent = "Pizza #" + pizzaData[(i / 100)%pizzaData.length].name;

            if (i % 100 == 0) {

                container.appendChild(div);
            }
        }

        setInterval(increaseProgressBar, 10);
    })();
</script>