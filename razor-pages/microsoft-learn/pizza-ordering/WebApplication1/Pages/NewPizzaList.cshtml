@page
@model WebApplication1.Pages.NewPizzaListModel
@{
}

@using WebApplication1.Models

<div class="row" style="height: 100vh">
    <div class="ms-0 mt-0 col-2 container bg-danger-subtle h-100">
        <div class="card  w-100">Hei</div>
        <span>@Model.MinPizzaPrice</span> 
        <span class="float-end">@Model.MaxPizzaPrice</span> 
        <input type="range" id="progressSpeed" class="form-range" min="@Model.MinPizzaPrice" max="@Model.MaxPizzaPrice" value="@Model.MinPizzaPrice" onchange="rangevalue.value=value">

        <label class="form-label">Toppings</label>
        @foreach (var topping in Enum.GetValues<Topping>())
        {
            <div class="form-check">
                <input type="checkbox" 
                       name="NewPizza.Toppings" 
                       value="@topping" 
                       class="form-check-input" 
                       id="topping_@topping" />
                <label class="form-check-label" for="topping_@topping">
                    @topping
                </label>
            </div>
        }

        <div class="form"></div>



    </div>

    <div class=" col-10 container w-50 h-100 d-flex flex-wrap">Hei</div>

</div>

<script>


</script>
